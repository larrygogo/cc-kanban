.superpowers/
node_modules/
target/
# 隔离校验用 cargo target(dev 实例占用 target/ 的 exe 时,CARGO_TARGET_DIR=<名> 跑测试)。
# 两个名字都收:历史脚手架与部分会话用 target-verify,新约定用 target-check——
# 任一未忽略都会让 git status -uall 灌进上万条产物、把「更改」计数撑爆。
target-check/
target-verify/
dist/
# 手机远程 UI 的独立构建产物(vite.mobile.config.ts 输出)。beforeBuildCommand 每次
# 重建,打进安装包由 tauri.conf.json 的 bundle.resources 负责,不入库。
dist-mobile/
# 本项目用 bun(bun.lock)。npm 的 package-lock.json 只会是误跑 npm/npx 的产物,不入库。
package-lock.json
dev.log
*.db
*.db-wal
*.db-shm
app/src-tauri/gen/
# prepare-sidecar.mjs 生成的 sidecar 产物（构建时按 target triple 重新生成）
app/src-tauri/binaries/
# E2E 构建期由 e2e/run.mjs 临时拷入的 WDIO capability，跑完即删，不应入库
app/src-tauri/capabilities/wdio.json
# WDIO 运行时的日志捕获目录
app/logs/

# macOS 签名材料(私钥/证书/p12),绝不提交
.signing/

# Claude Code：worktree 工作副本与本地设置覆盖。
# 不整个忽略 .claude/——项目级的 settings.json / skills 是该入库共享的。
.claude/worktrees/
.claude/settings.local.json

# Next.js 误生成的构建输出（本项目用 Vite，此目录只会是误跑 next 的产物）
.next/

# 本地海报/聊天预览导出的临时工具页（半成品草稿；若完善成正式工具应改为提交，
# 与已入库的 scripts/record-demo.mjs 同等对待）
app/chat-preview.html
app/poster.html
app/scripts/export-poster.mjs
app/src/chat-preview.tsx
